# Скопируй в .env.local и заполни.

# Яндекс.Метрика — номер счётчика (например, 98765432).
# Без него счётчик не подключается. NEXT_PUBLIC_ — значение попадает в клиент.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Telegram-бот для заявок с формы «Прислать разбор». Серверные, в клиент НЕ попадают.
# TOKEN — создать бота у @BotFather и взять токен.
TELEGRAM_BOT_TOKEN=
# CHAT_ID — куда слать заявки (свой личный chat_id узнать у @userinfobot).
# Важно: один раз напишите своему боту в личку, иначе он не сможет вам написать.
TELEGRAM_CHAT_ID=

# Подтверждение прав на сайт (SEO). Токены берутся при добавлении домена:
# GOOGLE — Search Console → способ «HTML-тег» → значение content="…".
GOOGLE_SITE_VERIFICATION=
# YANDEX — Яндекс.Вебмастер → «Мета-тег» → значение content="…".
YANDEX_VERIFICATION=
